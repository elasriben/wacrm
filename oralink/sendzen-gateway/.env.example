# Gateway configuration — NO secrets here. The SendZen API key is NOT configured on the gateway:
# waCRM sends it (as the number's stored access token) in the Authorization header and the
# gateway forwards it unchanged.

# SendZen API base (https only; http allowed for loopback in tests)
SENDZEN_API_BASE=https://api.sendzen.io

# phone_number_id used by waCRM  ->  value SendZen expects in "from".
# UNVERIFIED: whether SendZen's "from" is the numeric phone number id or an E.164 number.
# Fill "from" accordingly after test T-S5 (see ../sendzen-test-kit/TEST-PLAN.md).
# One entry per number; TranZit and Immerview numbers are independent accounts in waCRM.
NUMBER_MAP={"123456789012345":{"from":"+212600000000","label":"example-only"}}

# Message types forwarded to SendZen. Others answer 501 (honest) until verified.
ALLOW_TYPES=text,interactive

HOST=127.0.0.1
PORT=8080
MAX_BODY_BYTES=262144
SENDZEN_TIMEOUT_MS=15000
