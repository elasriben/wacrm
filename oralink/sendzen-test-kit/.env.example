# Test-kit configuration — NO real secrets in git. Copy to .env.local (git-ignored) and export it in your shell.
# --- capture-server.mjs ---
# Comma-separated candidate webhook secrets (the "secret" you gave SendZen when creating the webhook config).
SENDZEN_WEBHOOK_SECRET=
FAIL_NEXT=0
# --- send-test.mjs (only with --send) ---
SENDZEN_API_BASE=https://api.sendzen.io
SENDZEN_API_KEY=
# The DEDICATED test number's identifier as SendZen expects it in "from" (phone number id OR E.164 — that is test T-S5).
FROM=
# Your own test phone (E.164 without spaces).
TO=
TEST_FROM=
ALLOWED_TEST_RECIPIENTS=
# Production numbers that must NEVER be used (TranZit's existing numbers, E.164 and/or ids).
PROTECTED_FROM=
